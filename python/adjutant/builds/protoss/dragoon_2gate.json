      "Forge": "bases >= 2",
      "Robotics_Facility": "enemy_cloak or bases >= 2",
      "Observatory": "enemy_cloak"
    },
    "units": {"Zealot": 4, "Dragoon": 40, "Observer": "2 if enemy_cloak else 1"},
    "upgrades": [["Singularity_Charge", 1], ["Protoss_Ground_Weapons", 1]]
  }
}
